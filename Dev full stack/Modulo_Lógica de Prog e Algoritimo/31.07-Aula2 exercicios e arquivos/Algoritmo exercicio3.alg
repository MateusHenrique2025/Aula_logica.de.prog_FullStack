Algoritmo "exercicio3"

// ler um numero e exibir o dobro 
Var
// Seção de Declarações das variáveis 

	numero, dobro : inteiro

Inicio
// Seção de comandos, procedimentos, funções, operador
	escreval ("Digite um numero: ")
	leia(numero)

	dobro <- numero*2
	escreval ("Você digitou o numero: ",numero)
	escreval ("o dobro dele é ", dobro)

Fimalgoritimo
